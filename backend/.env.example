# Copy this file to .env and adjust as needed.
#   copy .env.example .env

# mock = explicit Demo Model (no trained accuracy). real = load the Phase 4 checkpoint.
# real never falls back to mock if the file is missing.
MODEL_MODE=mock

# Path is relative to the backend/ directory unless absolute.
# After training, this can point at the Phase 4 checkpoint:
# MODEL_PATH=../ml/models/best_model.pth
MODEL_PATH=models/best_model.pth

# Accept a prediction only at or above this confidence.
CONFIDENCE_THRESHOLD=0.80

# Number of frames in each temporal window sent to the model.
SEQUENCE_LENGTH=30

# Majority-vote window for live WebSocket predictions.
SMOOTHING_WINDOW=5

# Device for MODEL_MODE=real (cpu is enough for the laptop MVP).
INFERENCE_DEVICE=cpu

# Language layer (Phase 6). "rules" is the shipped backend; swap later for NLP/LLM.
LANGUAGE_BACKEND=rules
PAUSE_SECONDS=1.2
REPEAT_HOLD=12

# Labels file (relative to backend/ unless absolute).
LABELS_PATH=config/labels.json

# API bind settings
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
