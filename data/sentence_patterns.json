{
  "version": 1,
  "backend": "rules",
  "description": "Rule-based gloss-to-sentence patterns. Key is pipe-separated gloss ids. Replace this file or swap LANGUAGE_BACKEND later for an NLP/LLM engine.",
  "fallback": "join_with_spaces",
  "separator": "|",
  "patterns": {
    "HELLO": "Hello.",
    "GOOD_MORNING": "Good morning.",
    "THANK_YOU": "Thank you.",
    "PLEASE": "Please.",
    "HELP": "Help.",
    "YES": "Yes.",
    "NO": "No.",
    "WATER": "Water.",
    "FOOD": "Food.",
    "DOCTOR": "Doctor.",
    "HOSPITAL": "Hospital.",
    "MEDICINE": "Medicine.",
    "PAIN": "Pain.",
    "EMERGENCY": "Emergency.",
    "HOME": "Home.",
    "NEED": "Need.",
    "CALL": "Call.",
    "I|NEED|DOCTOR": "I need a doctor.",
    "I|NEED|WATER": "I need water.",
    "I|NEED|FOOD": "I need food.",
    "I|NEED|HELP": "I need help.",
    "I|NEED|MEDICINE": "I need medicine.",
    "CALL|DOCTOR": "Please call a doctor.",
    "WHERE|HOSPITAL": "Where is the hospital?",
    "WHERE|HOME": "Where is home?",
    "WHAT|NAME": "What is your name?"
  }
}
