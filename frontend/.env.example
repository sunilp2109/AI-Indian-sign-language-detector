# Copy to .env for local overrides.
#   copy .env.example .env

VITE_API_URL=http://127.0.0.1:8000
VITE_WEBSOCKET_URL=ws://127.0.0.1:8000/ws/translate

# Optional overrides. Defaults use local WASM copied on npm install
# and the public MediaPipe hand landmarker model.
# VITE_MEDIAPIPE_WASM_URL=/mediapipe/wasm
# VITE_HAND_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
